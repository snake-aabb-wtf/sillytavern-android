<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Compose host: MainActivity calls setContent() once the server is Ready. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_installing"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonViewLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_view_log" />

            <Button
                android:id="@+id/buttonRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/error_retry" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating overlay control: draggable, snaps to a side, and remembers its spot.
         Only its own disc consumes touches; the rest of the screen stays interactive.
         Drawn last so it stays reachable even when the splash or the error panel is up
         (a failed import must not trap the user). Starts invisible: the saved position
         needs a laid-out parent. -->
    <com.sol.sillytavern.ui.FloatingGearButton
        android:id="@+id/buttonSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_settings_button"
        android:contentDescription="@string/settings_open"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings"
        android:tint="@android:color/white"
        android:visibility="invisible" />
</FrameLayout>
